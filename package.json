{
  "name": "litefy-fuma",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm node scripts/copy-registry.js && node scripts/build-page-trees.mjs",
    "build": "react-router build",
    "dev": "react-router dev",
    "types:check": "react-router typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "cli:build": "pnpm --filter=litefy run build",
    "cli:link": "pnpm --filter=litefy exec npm link",
    "preview":"vite preview"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@react-router/node": "^7.18.3",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-registry": "^0.3.2",
    "fumadocs-ui": "16.9.3",
    "isbot": "^5.2.2",
    "lucide-react": "^1.37.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.3",
    "tailwind-merge": "^3.6.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@react-router/dev": "^7.18.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "fs-extra": "^11.4.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.80.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  }
}
