{
  "name": "litefy-fuma",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "pnpm node scripts/copy-registry.js && node scripts/build-page-trees.mjs",
    "build": "react-router build",
    "dev": "react-router dev  ",
    "start": "serve ./build/client --config ../../serve.json",
    "types:check": "react-router typegen && fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "cli:build": "pnpm --filter=litefy run build",
    "cli:link": "pnpm --filter=litefy exec npm link"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "@react-router/node": "^7.16.0",
    "fumadocs-core": "16.9.3",
    "fumadocs-mdx": "15.0.11",
    "fumadocs-registry": "^0.3.2",
    "fumadocs-ui": "16.9.3",
    "isbot": "^5.1.40",
    "lucide-react": "^1.17.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.16.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@react-router/dev": "^7.16.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "fs-extra": "^11.3.5",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^7.3.3"
  }
}
